        <polygon points="32,8 38,24 56,26 42,38 46,56 32,46 18,56 22,38 8,26 26,24"/>
      </g>
    </symbol>
    <symbol id="ic-flame" viewBox="0 0 64 64">
      <g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M32 6c0 12-14 18-14 30 0 10 6 18 14 18s14-8 14-18C46 24 32 18 32 6z"/>
