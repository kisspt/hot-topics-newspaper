        <path d="M12 8c6 0 10 3 12 6M108 8c-6 0-10 3-12 6"/>
      </g>
    </symbol>
    <!-- Dynamic illustration icons for content-based selection -->
    <symbol id="ic-trophy" viewBox="0 0 64 64">
